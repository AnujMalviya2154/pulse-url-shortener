# ------------------------------------------------------------------------------
# PULSE LOCAL DEVELOPMENT ENVIRONMENT VARIABLES
# Copy this file to .env before starting Docker Compose:
#   Windows PowerShell: Copy-Item .env.example .env
#   Bash:               cp .env.example .env
#
# NEVER commit .env to source control.
# ALL CREDENTIALS BELOW ARE FOR LOCAL DEVELOPMENT ONLY.
# ------------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
WEB_PORT=3000

WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# PostgreSQL (local Docker container - 127.0.0.1:5432)
POSTGRES_USER=pulse_dev
POSTGRES_PASSWORD=replace_with_local_dev_pg_password
POSTGRES_DB=pulse_dev
DATABASE_URL=postgresql://pulse_dev:replace_with_local_dev_pg_password@127.0.0.1:5432/pulse_dev

# Redis (local Docker container - 127.0.0.1:6379, password authenticated)
REDIS_PASSWORD=replace_with_local_dev_redis_password
REDIS_URL=redis://:replace_with_local_dev_redis_password@127.0.0.1:6379

# RabbitMQ (local Docker container - 127.0.0.1:5672 AMQP / 127.0.0.1:15672 UI)
RABBITMQ_DEFAULT_USER=pulse_dev
RABBITMQ_DEFAULT_PASS=replace_with_local_dev_rabbitmq_password
RABBITMQ_URL=amqp://pulse_dev:replace_with_local_dev_rabbitmq_password@127.0.0.1:5672

# Session Secret (cryptographically random string for M2 sessions)
SESSION_SECRET=replace_with_long_random_secret_for_local_dev
