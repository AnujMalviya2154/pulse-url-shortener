# Placeholder template only. Copy to .env for local development and replace values locally.
# Never commit .env or real credentials.

NODE_ENV=development

# App URLs (final ports/origin strategy to be selected in M1)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# PostgreSQL — local Docker Compose values only
DATABASE_URL=postgresql://pulse_local:replace_me@localhost:5432/pulse_local

# Redis — local Docker Compose values only
REDIS_URL=redis://localhost:6379

# RabbitMQ — local Docker Compose values only
RABBITMQ_URL=amqp://pulse_local:replace_me@localhost:5672

# Auth/session secrets must be generated locally with a cryptographically secure tool.
SESSION_SECRET=replace_with_a_long_random_secret
